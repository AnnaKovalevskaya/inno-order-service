# PostgreSQL Configuration
POSTGRES_DB=orderdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# Kafka Configuration
KAFKA_BROKER_ID=1
KAFKA_ZOOKEEPER_CONNECT=zookeeper:2181
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:9092,PLAINTEXT_HOST://localhost:9092
KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_AUTO_CREATE_TOPICS_ENABLE=true
KAFKA_CREATE_TOPICS=create-order:1:1,create-payment:1:1

# Zookeeper Configuration
ZOOKEEPER_CLIENT_PORT=2181
ZOOKEEPER_TICK_TIME=2000

# Order Service Configuration
SPRING_PROFILES_ACTIVE=docker
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/orderdb
SPRING_DATASOURCE_USERNAME=anna
SPRING_DATASOURCE_PASSWORD=password
SERVER_PORT=8083

# Network Ports (for host access)
HOST_POSTGRES_PORT=5432
HOST_ZOOKEEPER_PORT=2181
HOST_KAFKA_PORT=9092
HOST_KAFKA_EXTERNAL_PORT=29092
HOST_ORDER_SERVICE_PORT=8083